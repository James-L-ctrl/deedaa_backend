generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  COD_PENDING
  COD_CONFIRMED
  COD_DELIVERED
  COD_CANCELLED
  GCASH_PENDING
  GCASH_COMPLETED
  GCASH_FAILED
  GCASH_CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  GCASH
  COD
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  name         String     @db.VarChar(120)
  role         Role       @default(CUSTOMER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cartItems    CartItem[]
  orders       Order[]
}

model Product {
  id          String      @id @default(uuid())
  slug        String      @unique @db.VarChar(255)
  name        String
  description String
  priceCents  Int
  imageUrl    String      @db.VarChar(512)
  category    String
  rating      Int         @default(5)
  stock       Int         @default(50)
  featured    Boolean     @default(false)
  bestseller  Boolean     @default(false)
  badge       String?
  isPreorder  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  status             OrderStatus @default(PENDING)
  subtotalCents      Int
  shippingCents      Int
  totalCents         Int
  shippingName       String      @db.VarChar(120)
  shippingAddress    String      @db.VarChar(255)
  shippingCity       String      @db.VarChar(100)
  shippingPostalCode String      @db.VarChar(12)
  shippingCountry    String      @db.VarChar(56)
  paymentMethod      PaymentMethod?
  gcashReferenceId   String?     @unique @db.VarChar(64)
  codReferenceId     String?     @unique @db.VarChar(64)
  statusChangedBy    String?
  statusChangedAt    DateTime?
  paidAt             DateTime?
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items              OrderItem[]
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String
  productId      String
  name           String
  unitPriceCents Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
}
