# DeaWeb Backend Environment Variables
# Copy to .env and fill in your values
# DO NOT commit .env to version control!

# Application
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/deedaa?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/deedaa?schema=public"

# Security - JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Security - Password Hashing
BCRYPT_ROUNDS="10"

# Seed Data (for initial database seeding)
SEED_ADMIN_EMAIL="admin@deedaa.com"
SEED_ADMIN_PASSWORD="changeme123"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="changeme123"

# Email (configure for production)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@deedaa.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="DeeaWeb <noreply@deedaa.com>"

# Rate Limiting
THROTTLE_TTL="60"
THROTTLE_LIMIT="100"